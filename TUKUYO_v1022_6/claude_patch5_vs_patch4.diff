+```bash
+python3 -B run_tukuyo.py --runtime-trust-file $A --data D research-run --world W1          # 1 回の探索
+python3 -B run_tukuyo.py --runtime-trust-file $A --data D research-run --world W1 --tier 4 --noise 0.05
+python3 -B run_tukuyo.py --runtime-trust-file $A --data D research-status
